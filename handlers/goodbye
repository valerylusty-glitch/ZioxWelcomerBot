"""
handlers/goodbye.py

Gestion des membres qui quittent le groupe.
"""

# ======================================================
# IMPORTS
# ======================================================

from telegram import Update
from telegram.ext import (
    Application,
    ContextTypes,
    MessageHandler,
    filters,
)

from database import database


# ======================================================
# DÉPART D'UN MEMBRE
# ======================================================

async def goodbye_member(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    """
    Déclenché lorsqu'un membre quitte le groupe.
    """

    if update.message is None:
        return

    member = update.message.left_chat_member

    if member is None:
        return

    chat = update.effective_chat

    group = await database.get_group(chat.id)

    # Suppression du membre de la base
    await database.remove_member(
        chat_id=chat.id,
        user_id=member.id,
    )

    # Ajout dans les logs
    await database.log(
        chat.id,
        member.id,
        "LEFT",
    )

    # Vérifie si le message d'au revoir est activé
    if not group["goodbye_enabled"]:
        return

    # Personnalisation du message
    goodbye = group["goodbye_message"]

    goodbye = (
        goodbye
        .replace("{user}", member.full_name)
        .replace("{group}", chat.title)
    )

    await update.message.reply_text(goodbye)


# ======================================================
# ENREGISTREMENT
# ======================================================

def register_goodbye(app: Application):
    """
    Enregistre le handler des départs.
    """

    app.add_handler(
        MessageHandler(
            filters.StatusUpdate.LEFT_CHAT_MEMBER,
            goodbye_member,
        )
    )
